{
  "App": {
    "SelfUrl": "https://localhost:44352",
    "ClientUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.WebAppSample.com,http://localhost:4200",
    "RedirectAllowedUrls": "http://localhost:4200",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Data Source=../WebAppSample.db;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44352",
    "SwaggerClientId": "WebAppSample_Swagger",
    "CertificatePassPhrase": "99c7649d-ec25-4d02-96cd-44b0030513b1"
  },
  "Settings": {
    "Abp.Identity.Password.RequireNonAlphanumeric": "false",
    "Abp.Identity.Password.RequireLowercase": "false",
    "Abp.Identity.Password.RequireUppercase": "false",
    "Abp.Identity.Password.RequireDigit": "false"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "9i7mnGkEhGaJ2LnS"
  },
  "OpenIddict": {
    "Applications": {
      "WebAppSample_App": {
        "ClientId": "WebAppSample_App",
        "RootUrl": "http://localhost:4200"
      },
      "WebAppSample_Swagger": {
        "ClientId": "WebAppSample_Swagger",
        "RootUrl": "https://localhost:44352"
      }
    }
  }
}
